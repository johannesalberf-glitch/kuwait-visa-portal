# Admin authentication password for /admin
ADMIN_PASSWORD=admin1234admin

# Supabase Cloud Database (Required for cross-device sync across different phones)
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key

# Optional aliases (also supported)
VITE_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
